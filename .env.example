# Copy to .env.local for local development. Never commit the real file.
# Both values are public-safe (the anon / publishable key is protected by RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key

# Web push public key (VAPID). Public-safe; the private key only goes in Supabase function secrets.
VITE_VAPID_PUBLIC_KEY=
